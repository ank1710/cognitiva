# Cognitiva — piloto por convite (Marco C)
# Copie para .env e preencha localmente. NUNCA versione tokens reais;
# os valores abaixo são apenas exemplos.

# Convites válidos, separados por vírgula. Sem esta variável, /api/analyze responde 503.
PILOT_TOKENS=convite-exemplo-a,convite-exemplo-b

# Limites em memória, por dia UTC e por minuto.
PILOT_PER_TOKEN_PER_DAY=20
PILOT_GLOBAL_PER_DAY=100
PILOT_PER_TOKEN_PER_MINUTE=4

# Provedor de IA. A chave fica apenas no servidor, nunca no frontend.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Preços de referência (USD por 1M de tokens) usados só na estimativa de log.
# Não são fatura do provedor; ajuste conforme o contrato real.
PILOT_PRICE_INPUT_PER_MTOK=0.25
PILOT_PRICE_OUTPUT_PER_MTOK=2.00
